# BARQ standalone Node API — copy to .env in your private deployment environment.
# Never commit real credentials or tokens.

HOST=0.0.0.0
PORT=8787

# libSQL / Turso. A local development database may use: file:./data/barq-local.db
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Required for JWT signing. Use a long, randomly generated secret.
JWT_SECRET=

# Optional S3-compatible object storage (or keep the existing Tigris variables).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Optional legacy Tigris-compatible credentials.
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Optional Firebase Cloud Messaging service account JSON.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Workers AI is not implicitly available in standalone Node mode.
# Supply an AI adapter programmatically when deploying a supported provider.
